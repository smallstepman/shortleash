{
  "type": "module",
  "name": "shortleash",
  "version": "0.1.0",
  "description": "Long-lived multi-agent orchestration extension and standalone runner for OMP",
  "homepage": "https://github.com/smallstepman/shortleash",
  "author": "Marcin Nowak Liebiediew <m.liebiediew@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smallstepman/shortleash.git",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/smallstepman/shortleash/issues"
  },
  "keywords": [
    "shortleash",
    "orchestration",
    "agent",
    "extension"
  ],
  "bin": {
    "omp-shortleash": "src/cli.ts"
  },
  "scripts": {
    "test": "bun test ./test/*.test.ts ./test/**/*.test.ts",
    "check": "biome check src test && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "lint": "biome lint src test",
    "fix": "biome check --write --unsafe src test",
    "fmt": "biome format --write src test"
  },
  "dependencies": {
    "@andrewjacop/pi-herdr": "^0.2.5",
    "@oh-my-pi/pi-utils": "^17.2.5",
    "@thi.ng/text-canvas": "^3.0.127",
    "d3-dag": "^1.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@oh-my-pi/pi-coding-agent": "^17.2.5",
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "7.0.0-dev.20260707.2"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=17.2.5 <18"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "omp": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./plugin": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ]
}
